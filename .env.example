# ============================================================
# ZODERISE HORIZON — local configuration
# Copy this file to .env and edit locally.
# Never commit your real .env file.
# ============================================================

ZODERISE_APP_NAME=ZODERISE
ZODERISE_APP_VERSION=8.2.0-HORIZON
ZODERISE_TAGLINE=Sovereign Local Intelligence

# Local storage
ZODERISE_DB=data/zoderise.db
ZODERISE_STORAGE=data/storage

# Ollama — loopback is the secure default
OLLAMA_BASE_URL=http://127.0.0.1:11434
ALLOW_NONLOCAL_OLLAMA=0
ZODERISE_TEXT_MODEL=zoderise:latest
ZODERISE_VISION_MODEL=zoderise-vision:latest
OLLAMA_CONNECT_TIMEOUT=3
OLLAMA_READ_TIMEOUT=600
ZODERISE_KEEP_ALIVE=3m
AI_NUM_CTX=4096
AI_NUM_BATCH=128
AI_INPUT_CHARS=8500
# Optional model directory for the Ollama process started by the launcher.
# ZODERISE_OLLAMA_MODELS=C:\Users\YOUR_NAME\.ollama\models

# Streamlit — localhost only by default
SERVER_HOST=127.0.0.1
SERVER_PORT=8501

# AI behavior
AI_TEMPERATURE=0.2
AI_NUM_PREDICT=2048
MAX_CONTEXT_MESSAGES=16
MAX_PROMPT_CHARS=16000
ZODERISE_MAX_HISTORY_MESSAGE_CHARS=5000

# RAG — no third model required; retrieval is local lexical/BM25-style
RAG_TOP_K=6
RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=220
RAG_SIMILARITY_THRESHOLD=0.15
ZODERISE_MAX_RETRIEVAL_CHUNKS=8000
ZODERISE_MAX_RAG_CONTEXT_CHARS=14000

# File security limits
MAX_UPLOAD_MB=25
ZODERISE_MAX_CHAT_ATTACHMENTS=4
ZODERISE_MAX_CHAT_TOTAL_MB=50
ZODERISE_MAX_PDF_PAGES=300
ZODERISE_MAX_IMAGE_PIXELS=25000000
ZODERISE_MAX_DOCX_UNCOMPRESSED_MB=100
ZODERISE_OCR_LANG=eng+fas+pus

# Authentication and retention
SESSION_HOURS=12
ZODERISE_MAX_ACTIVE_SESSIONS=8
ZODERISE_LOGIN_MAX_ATTEMPTS=5
ZODERISE_LOGIN_LOCK_SECONDS=60
ZODERISE_AUDIT_RETENTION_DAYS=90
ZODERISE_DEFAULT_PRIVACY_MODE=Ephemeral
ZODERISE_DEFAULT_ROLE=student
ZODERISE_ENABLE_REGISTRATION=1
ZODERISE_REQUIRE_ADMIN_APPROVAL=0

# Optional admin bootstrap.
# If left blank, the first registered local account becomes administrator.
ZODERISE_ADMIN_NAME=ZODERISE Administrator
ZODERISE_ADMIN_USERNAME=admin
ZODERISE_ADMIN_EMAIL=
ZODERISE_ADMIN_PASSWORD=
